<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sm.pos.custom.sequence</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="sm_pos_custom_sequence_setting"
                         string="Set Receipt Sequence Number"
                         help="Number receipts with a custom sequence (prefix, suffix, padding)">
                    <field name="pos_sm_use_receipt_sequence"/>
                    <div class="content-group mt16" invisible="not pos_sm_use_receipt_sequence">
                        <field name="pos_sm_receipt_sequence_id"
                               placeholder="Select a sequence..."/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
